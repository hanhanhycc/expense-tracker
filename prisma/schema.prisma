// Prisma schema — Expense Tracker
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum TxType {
  INCOME
  EXPENSE
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum Visibility {
  PERSONAL
  SHARED
}

enum SplitType {
  NONE
  EQUAL
  CUSTOM
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum BudgetScope {
  PERSONAL // ngân sách riêng của 1 member
  SHARED   // ngân sách chung của cả family
}

enum AccountType {
  CASH    // Tiền mặt
  BANK    // Ngân hàng (Vietcombank, TPBank…)
  CARD    // Thẻ tín dụng (Visa, Master…)
  EWALLET // Ví điện tử (Momo, ZaloPay…)
  OTHER
}

// ─────────────────────────────────────────────────────────────
// Auth & Family
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  avatarPath   String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members FamilyMember[]

  @@map("users")
}

model Family {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        FamilyMember[]
  categories     Category[]
  transactions   Transaction[]
  savingGoals    SavingGoal[]
  invites        Invite[]
  notifications  Notification[]
  accounts       Account[]

  @@map("families")
}

model FamilyMember {
  id        String   @id @default(cuid())
  userId    String
  familyId  String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  createdTransactions Transaction[]        @relation("CreatedBy")
  paidTransactions    Transaction[]        @relation("PaidBy")
  shares              TransactionShare[]
  goalMemberships     SavingGoalMember[]
  contributions       SavingContribution[]
  budgets             Budget[]
  notifications       Notification[]       @relation("NotifRecipient")
  actedNotifications  Notification[]       @relation("NotifActor")
  pushSubscriptions   PushSubscription[]

  @@unique([userId, familyId])
  @@index([familyId])
  @@map("family_members")
}

model Invite {
  id        String   @id @default(cuid())
  familyId  String
  code      String   @unique
  email     String?
  role      Role     @default(MEMBER)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("invites")
}

// ─────────────────────────────────────────────────────────────
// Categories
// ─────────────────────────────────────────────────────────────

model Category {
  id        String       @id @default(cuid())
  familyId  String
  name      String
  kind      CategoryKind
  icon      String?
  color     String?
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@index([familyId])
  @@index([familyId, kind])
  @@map("categories")
}

// ─────────────────────────────────────────────────────────────
// Budgets — ngân sách theo category, theo tháng
// ─────────────────────────────────────────────────────────────

model Budget {
  id         String      @id @default(cuid())
  familyId   String
  categoryId String
  month      DateTime    @db.Date // luôn ngày đầu tháng UTC, ví dụ 2026-05-01
  amount     Decimal     @db.Decimal(18, 2)
  scope      BudgetScope @default(SHARED)
  // null ⇒ ngân sách chung (scope=SHARED). Có giá trị ⇒ ngân sách riêng member đó (scope=PERSONAL).
  memberId   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  category Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  member   FamilyMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Postgres coi NULL distinct ⇒ unique không bảo vệ được SHARED trùng;
  // logic upsert ở service xử lý bằng cach query trước khi insert.
  @@unique([familyId, categoryId, month, memberId])
  @@index([familyId, month])
  @@index([memberId])
  @@map("budgets")
}

// ─────────────────────────────────────────────────────────────
// Transactions
// ─────────────────────────────────────────────────────────────

model Transaction {
  id          String     @id @default(cuid())
  familyId    String
  amount      Decimal    @db.Decimal(18, 2)
  type        TxType
  categoryId  String
  accountId   String?    // nullable để migrate giao dịch cũ; new transactions nên có
  note        String?
  date        DateTime   @db.Date
  createdById String
  paidById    String
  visibility  Visibility @default(PERSONAL)
  splitType   SplitType  @default(NONE)
  receiptPath String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  family    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  category  Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account   Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy FamilyMember @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  paidBy    FamilyMember @relation("PaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  shares    TransactionShare[]

  @@index([familyId])
  @@index([familyId, date])
  @@index([familyId, categoryId])
  @@index([familyId, accountId])
  @@map("transactions")
}

model TransactionShare {
  id            String  @id @default(cuid())
  transactionId String
  memberId      String
  amount        Decimal @db.Decimal(18, 2)

  transaction Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  member      FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([transactionId, memberId])
  @@index([memberId])
  @@map("transaction_shares")
}

// ─────────────────────────────────────────────────────────────
// Saving Goals
// ─────────────────────────────────────────────────────────────

model SavingGoal {
  id           String     @id @default(cuid())
  familyId     String
  name         String
  description  String?
  targetAmount Decimal    @db.Decimal(18, 2)
  targetDate   DateTime?  @db.Date
  status       GoalStatus @default(ACTIVE)
  visibility   Visibility @default(SHARED)
  createdById  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  family        Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  members       SavingGoalMember[]
  contributions SavingContribution[]

  @@index([familyId])
  @@map("saving_goals")
}

model SavingGoalMember {
  id           String @id @default(cuid())
  savingGoalId String
  memberId     String

  savingGoal SavingGoal   @relation(fields: [savingGoalId], references: [id], onDelete: Cascade)
  member     FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([savingGoalId, memberId])
  @@index([memberId])
  @@map("saving_goal_members")
}

model SavingContribution {
  id           String   @id @default(cuid())
  savingGoalId String
  memberId     String
  amount       Decimal  @db.Decimal(18, 2)
  note         String?
  date         DateTime @db.Date
  createdAt    DateTime @default(now())

  savingGoal SavingGoal   @relation(fields: [savingGoalId], references: [id], onDelete: Cascade)
  member     FamilyMember @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@index([savingGoalId])
  @@index([memberId])
  @@map("saving_contributions")
}

// ─────────────────────────────────────────────────────────────
// Activity Log
// ─────────────────────────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(cuid())
  familyId   String
  actorId    String?  // userId — null nếu hệ thống
  actorName  String   // snapshot tên (để giữ log kể cả khi user bị xoá)
  action     String   // CREATE / UPDATE / DELETE / INVITE / ROLE_CHANGE ...
  entity     String   // saving_goal / contribution / member / invite / family / profile
  entityId   String?
  summary    String   // mô tả tiếng Việt ngắn gọn
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([familyId, createdAt])
  @@index([familyId, entity])
  @@map("activity_logs")
}

// ─────────────────────────────────────────────────────────────
// Notifications — thông báo in-app cho từng member
// ─────────────────────────────────────────────────────────────

model Notification {
  id          String    @id @default(cuid())
  familyId    String
  recipientId String    // FamilyMember nhận thông báo
  actorId     String?   // FamilyMember tạo ra hành động (null nếu hệ thống)
  actorName   String    // snapshot tên actor
  type        String    // TRANSACTION_SHARED | TRANSACTION_SHARE_UPDATED
  entity      String    // transaction
  entityId    String?
  summary     String    // mô tả tiếng Việt
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  family    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  recipient FamilyMember @relation("NotifRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     FamilyMember? @relation("NotifActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
  @@index([familyId])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────
// Push Subscriptions — Web Push API per device/browser
// ─────────────────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  memberId  String
  endpoint  String   @unique
  p256dh    String   // public key của browser
  auth      String   // auth secret
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("push_subscriptions")
}

// ─────────────────────────────────────────────────────────────
// Accounts — nguồn tiền (Cash / Bank / Card / E-wallet)
// Label cho transaction. KHÔNG track balance hay transfer (Mức A).
// ─────────────────────────────────────────────────────────────

model Account {
  id        String      @id @default(cuid())
  familyId  String
  name      String      // "Cash", "Vietcombank", "TPBank", "Visa"
  type      AccountType
  icon      String?
  color     String?
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([familyId])
  @@map("accounts")
}

