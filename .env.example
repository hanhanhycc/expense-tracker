# --- App ---
AUTH_SECRET=replace_me_with_openssl_rand_base64_32
AUTH_URL=http://localhost:3000
NODE_ENV=production

# --- Database (Postgres) ---
POSTGRES_USER=expense
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=expense

# Connection string dùng bởi Prisma
# - Khi chạy bằng docker-compose: host = "db" (tên service)
# - Khi dev local không docker: host = "localhost"
DATABASE_URL=postgresql://expense:change_me_strong_password@db:5432/expense?schema=public

# Port public ra ngoài (host)
APP_PORT=3000

# Thư mục lưu ảnh hoá đơn (bill). Mặc định: ./uploads (relative cwd).
# Trong Docker đã mount sẵn ./data/uploads → /app/uploads
UPLOAD_DIR=/app/uploads

# --- Web Push (thông báo đẩy real-time tới home screen) ---
# Sinh keys 1 lần: pnpm vapid:gen → copy ra đây.
# Nếu để trống → web push disabled, vẫn có in-app notification + polling.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
